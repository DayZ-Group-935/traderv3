# Group 935 Calculator — environment names only. Never commit values.
# Render sets PORT. This process binds 0.0.0.0 when PORT is set.
# On that host set COOKIE_SECURE=true and a durable SESSION_SECRET
# (at least 32 characters). Do not put a public hostname in this file.
# DISCORD_REDIRECT_URI must be the exact HTTPS callback registered on the
# Discord app after a service URL exists:
#   https://<render-host>/auth/discord/callback
# Leave secret values empty here. Supply them only in the host environment.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787

# Optional. If unset, a random secret is generated at process start.
# Sessions are memory-only and will not survive a restart in any case.
SESSION_SECRET=

# Cookie flags. Leave Secure unset/false for http://localhost.
# SameSite is Lax so the official Discord OAuth redirect can complete.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# ---------------------------------------------------------------------------
# Discord OAuth — required for LIVE sign-in
# App name: Group 935 Calculator
# Scopes (exact): identify guilds.members.read
# Redirect URI (exact): http://localhost:8787/auth/discord/callback
# These scopes are self-only: the OAuth bearer can read the signed-in user
# and that user's own guild membership. It cannot search other members.
# ---------------------------------------------------------------------------
# Known non-secret app ID for the existing separate "Group 935 Calculator"
# application. This is not a completed login config: a client secret is still
# required and has not been supplied.
# DISCORD_CLIENT_ID=1569978589556904077
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/auth/discord/callback

# Official API root. Do not change unless Discord documents a new root.
DISCORD_API_BASE=https://discord.com/api/v10
DISCORD_AUTHORIZE_URL=https://discord.com/oauth2/authorize

# Live Group 935 guild (verified). Do not invent a different default.
DISCORD_GUILD_ID=1213578527522431046

# Elevated read access is Trader OR Server Owner OR High Level Staff,
# checked from live membership server-side. Client mode is ignored.
# Fail closed when a role ID is unset. Verified live names + IDs (not secrets):
#   Trader        1215060053191819324  (exact live name "Trader")
#   Server Owner  1215040829186383912  (exact live name "Server Owner")
#   High Lvl Staff 1215042184764723251
# The High Level Staff grant is the unique Discord role "High Lvl Staff".
# That is a Design interpretation of Alex's 12:24 phrase "High Level Staff"
# as a known label abbreviation, not a claim that a literal role named
# "High Level Staff" exists, and not an alias of any other staff/admin role.
# Do not set Discord Administrator or neighboring staff/admin labels here.
# Do not invent discount-role keys; no discount amounts are authorized,
# and the mapper stays fail-closed.
DISCORD_TRADER_ROLE_ID=
DISCORD_SERVER_OWNER_ROLE_ID=
DISCORD_HIGH_LEVEL_STAFF_ROLE_ID=

# ---------------------------------------------------------------------------
# Optional later extension: server-held Discord bot for customer lookup
# Approved shape: HTTP-only, permission integer 0, all Privileged Gateway
# Intents off, no Gateway connection. Official docs: Get Member, Search,
# and Get Roles do not require the Server Members intent. List Guild
# Members requires GUILD_MEMBERS even over HTTP — never call it.
# Live success of those GET routes with permissions=0 is not yet verified.
# OAuth bearer tokens MUST NOT be used to search other members.
# Leave unset until a new, separately issued bot token is supplied through
# a secure reference (not chat). Do not reuse an existing bot token.
# When set, the server allowlists only these official documented GET routes:
#   GET /guilds/{guild.id}/members/{user.id}
#   GET /guilds/{guild.id}/members/search
#   GET /guilds/{guild.id}/roles
# Elevated authorization still uses the signed-in user's current membership
# (OAuth self-only: identify + guilds.members.read) and is fail-closed.
# It grants scoped read-only calculator access (identity, roles, mapped
# cash/bank, customer lookup). It does not grant cash or role writes.
# Customer lookup also requires a later guild install of this app's bot only.
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Killfeed / DayZ++ economy API
# Official docs: https://dayz-plus-plus-api.readme.io/
# Documented read route only:
#   GET https://api.killfeed.xyz/guilds/{guild_id}/economy/users/{user_id}
# Auth header: Api-Key: <key>
# Use the new minimum read-only key for this POC. NEVER place, view, use, or
# replace existing broad key ID 22 or any admin key here.
#
# Preferred secret reference (mode 600, not this file):
#   secrets/killfeed-api-key
# Or set KILLFEED_API_KEY_FILE to that path. Leave KILLFEED_API_KEY empty so
# the key is not duplicated in .env. The server reads the file in-process
# only; it is never logged or returned in /health, /status, or HTML.
#
# Verified 2026-11-11 12:15 America/Toronto (one LIVE GET 200, no amounts
# recorded here): {guild_id} and {user_id} accepted Discord snowflakes
# 1213578527522431046 and 413495850313187350. Schema is exactly
# bank (integer), bank_str (base-10 integer digit string), cash (integer),
# cash_str (base-10 integer digit string), with cash_str === String(cash)
# and bank_str === String(bank). No unit field. Cash and bank stay distinct;
# no total or spendability is invented.
#
# Observed rate policy on that call: RateLimit-Limit 30,
# RateLimit-Policy 30;w=60;gcra-burst=3. Do not add extra live calls.
# There is no write/spend route in this POC. Search stays disabled.
# ---------------------------------------------------------------------------
KILLFEED_API_BASE=https://api.killfeed.xyz
KILLFEED_API_KEY=
KILLFEED_API_KEY_FILE=
# Verified Discord guild id for this economy (not a secret):
KILLFEED_GUILD_ID=1213578527522431046

# Verified confirmation value after the 12:15 America/Toronto live GET:
KILLFEED_USER_ID_SEMANTICS=discord_user_id
